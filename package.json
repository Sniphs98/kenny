{
	"name": "kenny",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:scenario": "node scripts/scenario.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run i18n:compile && svelte-kit sync",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "npm run i18n:compile && vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage",
		"guard": "node scripts/hygiene-guard.mjs",
		"verify": "npm run guard && npm run format:check && npm run lint && npm run check && npm run test:ci && npm run build",
		"test:e2e:production": "npm run build && playwright test",
		"docker:build": "docker build -t kenny:local .",
		"docker:test": "bash scripts/docker-smoke.sh kenny:local",
		"test:ci": "npm run i18n:compile && vitest run --coverage",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.26.0",
		"@inlang/plugin-message-format": "^4.4.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@vitest/coverage-v8": "^5.0.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.53.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"sveltekit-superforms": "^3.0.0",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=22.13 <23"
	}
}
