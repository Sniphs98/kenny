# Path to the SQLite database
DATABASE_URL=data/kenny.db
# Long, random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=bitte-aendern
# Public URL of the app
BETTER_AUTH_URL=http://localhost:5173

# Attachment storage directory and maximum file size in MB
# ATTACHMENTS_DIR=data/attachments
# ATTACHMENT_MAX_MB=25

# Optional: Microsoft (Entra ID) sign-in
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Docker Compose: publicly accessible URL and desired image version
# KENNY_ORIGIN=http://localhost:3000
# KENNY_VERSION=0.1.0
# BODY_SIZE_LIMIT=30M
