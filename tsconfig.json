{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// @toast-ui/editor ships types but does not expose them through its package exports.
		"paths": {
			"@toast-ui/editor": ["./node_modules/@toast-ui/editor/types/index.d.ts"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts",
		"playwright.config.ts",
		"tests",
		"vitest.config.ts",
		"scripts/start-server.mjs"
	]
}
