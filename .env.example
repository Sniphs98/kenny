# Pfad zur SQLite-Datenbank
DATABASE_URL=data/kenny.db
# Zufälliger, langer geheimer Schlüssel, z.B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=bitte-aendern
# Öffentliche URL der App
BETTER_AUTH_URL=http://localhost:5173

# Ablage für Dateianhänge und maximale Größe pro Datei in MB
# ATTACHMENTS_DIR=data/attachments
# ATTACHMENT_MAX_MB=25

# Optional: Anmeldung mit Microsoft (Entra ID)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
